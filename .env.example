# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Every value here is a safe placeholder, not a real credential.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public base URL of this API. Used to build the embed snippet.
PUBLIC_BASE_URL=http://localhost:3000

# --- database -------------------------------------------------------------
# Matches the service in docker-compose.yml.
DATABASE_URL=postgres://widget:widget@localhost:5432/widgets

# --- auth -----------------------------------------------------------------
# Replace with a long random string: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# --- widget delivery ------------------------------------------------------
# Bumped on every widget bundle release; becomes part of the immutable URL.
WIDGET_BUILD_VERSION=1
CONFIG_CACHE_MAX_AGE=60
LOADER_CACHE_MAX_AGE=300
BUNDLE_CACHE_MAX_AGE=31536000

# --- submission limits ----------------------------------------------------
SUBMISSION_BODY_LIMIT=16kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=20
RATE_LIMIT_MAX_PER_WIDGET=60
# Minimum milliseconds between widget render and submit; faster than this = bot.
SPAM_MIN_FILL_MS=1200

# --- geo enrichment -------------------------------------------------------
# mode: live | mock_ok | down     (mock_ok / down make the fallback proof deterministic)
GEO_ENABLED=true
GEO_TIMEOUT_MS=1500
GEO_PROVIDER_A_MODE=live
GEO_PROVIDER_B_MODE=live

# --- side effects (email / webhook) ---------------------------------------
# transport: console | smtp | webhook | fail  ("fail" always throws — proves PROBE 5)
SIDE_EFFECT_TRANSPORT=console
SIDE_EFFECT_WEBHOOK_URL=
SIDE_EFFECT_MAX_ATTEMPTS=3
WORKER_POLL_MS=1000
WORKER_ENABLED=true
# Local mail catcher (Mailpit). Leave blank unless SIDE_EFFECT_TRANSPORT=smtp.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@widgets.local

# --- test / demo ----------------------------------------------------------
# Origin the demo "customer site" is served from.
DEMO_SITE_ORIGIN=http://localhost:5500
